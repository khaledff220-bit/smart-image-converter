    <script>
        (function() {
            console.log("🚀 تهيئة نظام التنقل بين الصفحات");
            
            // الحصول على جميع الأقسام
            const sections = {
                home: document.getElementById('home'),
                'compress-pdf': document.getElementById('compress-pdf'),
                'merge-pdf': document.getElementById('merge-pdf'),
                'password-protect': document.getElementById('password-protect'),
                'decrypt': document.getElementById('decrypt'),
                'image-quality': document.getElementById('image-quality'),
                'image-to-pdf': document.getElementById('image-to-pdf')
            };
            
            // دالة لإظهار قسم وإخفاء الباقي
            function showSection(sectionId) {
                console.log("📄 عرض القسم:", sectionId);
                
                // إخفاء جميع الأقسام
                Object.keys(sections).forEach(id => {
                    if (sections[id]) {
                        sections[id].classList.remove('active');
                    }
                });
                
                // إظهار القسم المطلوب
                if (sections[sectionId]) {
                    sections[sectionId].classList.add('active');
                }
                
                // تحديث عنوان الصفحة
                let pageTitle = "Smart Image Converter";
                switch(sectionId) {
                    case 'home': pageTitle = "الرئيسية - تحويل الصور إلى PDF وضغط PDF"; break;
                    case 'compress-pdf': pageTitle = "ضغط PDF - قلص حجم ملفات PDF مجاناً"; break;
                    case 'merge-pdf': pageTitle = "دمج PDF - ادمج عدة ملفات PDF في ملف واحد"; break;
                    case 'image-to-pdf': pageTitle = "تحويل الصور إلى PDF - تحويل JPG و PNG إلى PDF"; break;
                    case 'image-quality': pageTitle = "تحسين جودة الصور - رفع دقة الصور مجاناً"; break;
                    case 'password-protect': pageTitle = "حماية الصور - تشفير الصور بكلمة مرور"; break;
                    case 'decrypt': pageTitle = "فك تشفير الصور - استعادة الصور الأصلية"; break;
                }
                document.title = pageTitle + " | Smart Image Converter";
            }
            
            // ربط جميع روابط التنقل
            const navLinks = document.querySelectorAll('[data-nav]');
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const sectionId = this.getAttribute('data-nav');
                    if (sectionId && sections[sectionId]) {
                        showSection(sectionId);
                        // تحديث URL بدون إعادة تحميل
                        history.pushState(null, '', '#' + sectionId);
                    }
                });
            });
            
            // التعامل مع زر الرجوع/التقدم في المتصفح
            window.addEventListener('popstate', function() {
                const hash = window.location.hash.substring(1);
                if (hash && sections[hash]) {
                    showSection(hash);
                } else {
                    showSection('home');
                }
            });
            
            // التحقق من وجود hash في URL عند التحميل
            const initialHash = window.location.hash.substring(1);
            if (initialHash && sections[initialHash]) {
                showSection(initialHash);
            } else {
                showSection('home');
            }
            
            console.log("✅ نظام التنقل جاهز");
        })();
    </script>
