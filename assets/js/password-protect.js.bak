// أداة حماية الصور - تعمل مع النظام الديناميكي (SPA)

window.initpasswordprotect = function(containerId) {
    console.log("✅ تهيئة أداة حماية الصور في الحاوية:", containerId);

    const container = document.getElementById(containerId);
    if (!container) {
        console.error("❌ الحاوية غير موجودة:", containerId);
        return;
    }

    if (typeof CryptoJS === 'undefined') {
        container.innerHTML = '<div style="color: var(--color-error); text-align: center; padding: 40px;">❌ عذراً، مكتبة التشفير لم يتم تحميلها بعد</div>';
        return;
    }

    container.innerHTML = `
        <div class="tool-container">
            <h2>🔒 حماية الصور</h2>
            <p style="color: var(--text-muted); margin-bottom: 20px;">قم بتشفير صورك بكلمة مرور قوية باستخدام تقنية AES-256</p>

            <div class="drag-drop-zone" id="uploadArea" style="margin-bottom: 20px;">
                <div class="drag-icon">🖼️</div>
                <h3>اسحب الصورة هنا أو اضغط للاختيار</h3>
                <input type="file" id="fileUpload" accept="image/jpeg,image/png,image/gif,image/webp" style="display: none;">
            </div>

            <div id="fileInfo" style="display: none; background: var(--bg-card); border-radius: 12px; padding: 15px; margin: 20px 0;">
                <div id="fileName"></div>
            </div>

            <div id="previewContainer" style="display: none; text-align: center; margin: 20px 0;">
                <img id="selectionPreview" style="max-width: 100%; max-height: 200px; border-radius: 12px;">
            </div>

            <div style="margin: 20px 0;">
                <label>🔑 كلمة المرور</label>
                <input type="password" id="password" placeholder="أدخل كلمة مرور قوية (4 أحرف على الأقل)" style="width: 100%; padding: 12px; margin-top: 8px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-primary); color: white;">
                <div id="passwordStrength" style="margin-top: 8px; font-size: 12px;"></div>
            </div>

            <button class="btn" id="encryptBtn" style="width:100%;">🔒 تشفير الصورة</button>
            <div id="status" style="margin-top: 20px; text-align: center;"></div>

            <div id="resultArea" style="display: none; margin-top: 30px; padding: 20px; background: var(--bg-card); border-radius: 12px; border: 1px solid var(--color-success);">
                <div id="encryptionInfo"></div>
                <a href="#" id="downloadLink" class="btn" style="display: inline-block; margin-top: 15px;">📥 تحميل الصورة المشفرة</a>
            </div>
        </div>
    `;

    const uploadArea = container.querySelector('#uploadArea');
    const fileInput = container.querySelector('#fileUpload');
    const fileInfo = container.querySelector('#fileInfo');
    const fileNameSpan = container.querySelector('#fileName');
    const previewContainer = container.querySelector('#previewContainer');
    const previewImage = container.querySelector('#selectionPreview');
    const passwordInput = container.querySelector('#password');
    const strengthText = container.querySelector('#passwordStrength');
    const encryptBtn = container.querySelector('#encryptBtn');
    const statusDiv = container.querySelector('#status');
    const resultArea = container.querySelector('#resultArea');
    const encryptionInfo = container.querySelector('#encryptionInfo');
    const downloadLink = container.querySelector('#downloadLink');

    let selectedFile = null;
    let isProcessing = false;

    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(1024));
        return parseFloat((bytes / Math.pow(1024, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function analyzePassword(password) {
        if (!password) return { text: '', percentage: 0, color: 'var(--text-muted)' };
        let strength = 0;
        if (password.length >= 4) strength += 20;
        if (password.length >= 6) strength += 20;
        if (password.length >= 8) strength += 20;
        if (/[0-9]/.test(password)) strength += 15;
        if (/[a-z]/.test(password)) strength += 15;
        if (/[A-Z]/.test(password)) strength += 10;
        if (/[^a-zA-Z0-9]/.test(password)) strength += 10;
        strength = Math.min(strength, 100);
        if (strength < 30) return { text: 'ضعيفة', percentage: strength, color: 'var(--color-error)' };
        if (strength < 60) return { text: 'متوسطة', percentage: strength, color: 'var(--color-warning)' };
        return { text: 'قوية', percentage: strength, color: 'var(--color-success)' };
    }

    function updateButtonState() {
        if (!encryptBtn) return;
        const hasFile = selectedFile !== null;
        const hasPassword = passwordInput && passwordInput.value.length >= 4;
        encryptBtn.disabled = !(hasFile && hasPassword);
        encryptBtn.style.opacity = (hasFile && hasPassword) ? '1' : '0.6';
    }

    function setProcessing(processing) {
        isProcessing = processing;
        if (encryptBtn) {
            encryptBtn.disabled = processing;
            encryptBtn.textContent = processing ? '⏳ جاري التشفير...' : '🔒 تشفير الصورة';
        }
        if (fileInput) fileInput.disabled = processing;
        if (uploadArea) uploadArea.style.pointerEvents = processing ? 'none' : 'all';
    }

    function showNotification(message, type) {
        if (window.SmartImageConverter && window.SmartImageConverter.showToast) {
            window.SmartImageConverter.showToast(message, type);
        }
    }

    function handleFile(file) {
        if (!file || !file.type.startsWith('image/')) {
            showNotification('❌ الرجاء اختيار صورة صالحة', 'error');
            return;
        }
        selectedFile = file;
        if (fileInfo) fileInfo.style.display = 'block';
        if (fileNameSpan) {
            fileNameSpan.innerHTML = `<div><strong>${file.name}</strong><br><small>الحجم: ${formatFileSize(file.size)}</small></div>`;
        }
        const reader = new FileReader();
        reader.onload = (e) => {
            if (previewImage) previewImage.src = e.target.result;
            if (previewContainer) previewContainer.style.display = 'block';
        };
        reader.readAsDataURL(file);
        if (statusDiv) statusDiv.innerHTML = '';
        updateButtonState();
        showNotification('✅ تم اختيار الصورة بنجاح', 'success');
    }

    // ============================================
    // الدالة المحسنة للتشفير
    // ============================================
    async function encryptImage() {
        if (!selectedFile) {
            showNotification('❌ الرجاء اختيار صورة أولاً', 'error');
            return;
        }
        const password = passwordInput?.value?.trim();
        if (!password || password.length < 4) {
            showNotification('❌ كلمة المرور يجب أن تكون 4 أحرف على الأقل', 'error');
            return;
        }
        if (isProcessing) return;

        setProcessing(true);
        if (statusDiv) statusDiv.innerHTML = '<span style="color: var(--color-info);">⏳ جاري تشفير الصورة...</span>';

        try {
            // قراءة الصورة كـ ArrayBuffer (أفضل للصور الكبيرة)
            const arrayBuffer = await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => resolve(e.target.result);
                reader.onerror = reject;
                reader.readAsArrayBuffer(selectedFile);
            });

            // تحويل ArrayBuffer إلى WordArray
            const wordArray = CryptoJS.lib.WordArray.create(arrayBuffer);
            
            // تحويل كلمة المرور إلى مفتاح SHA256
            const key = CryptoJS.SHA256(password);
            
            // تشفير البيانات
            const encrypted = CryptoJS.AES.encrypt(wordArray, key).toString();

            if (!encrypted || encrypted.length === 0) {
                throw new Error('فشل التشفير');
            }

            const encryptedBlob = new Blob([encrypted], { type: 'application/octet-stream' });
            const url = URL.createObjectURL(encryptedBlob);

            if (downloadLink) {
                downloadLink.href = url;
                downloadLink.download = `protected_${selectedFile.name}.enc`;
            }

            if (encryptionInfo) {
                encryptionInfo.innerHTML = `
                    <div style="text-align: right;">
                        <p style="color: var(--color-success);">✅ تم التشفير بنجاح!</p>
                        <p>📁 الملف الأصلي: ${(selectedFile.size / 1024).toFixed(2)} KB</p>
                        <p>🔐 الملف المشفر: ${(encryptedBlob.size / 1024).toFixed(2)} KB</p>
                        <p style="color: #ffc107;">⚠️ احفظ كلمة المرور في مكان آمن</p>
                    </div>
                `;
            }

            if (resultArea) resultArea.style.display = 'block';
            if (statusDiv) statusDiv.innerHTML = '';
            showNotification('✅ تم تشفير الصورة بنجاح!', 'success');

        } catch (error) {
            console.error('Encryption error:', error);
            if (statusDiv) statusDiv.innerHTML = `<span style="color: var(--color-error);">❌ ${error.message || 'حدث خطأ أثناء التشفير'}</span>`;
            showNotification('❌ ' + (error.message || 'حدث خطأ أثناء التشفير'), 'error');
        } finally {
            setProcessing(false);
        }
    }

    passwordInput?.addEventListener('input', () => {
        const analysis = analyzePassword(passwordInput.value);
        if (strengthText) {
            strengthText.textContent = analysis.text;
            strengthText.style.color = analysis.color;
        }
        updateButtonState();
    });

    uploadArea?.addEventListener('click', () => fileInput?.click());
    fileInput?.addEventListener('change', (e) => {
        if (e.target.files[0]) handleFile(e.target.files[0]);
        fileInput.value = '';
    });

    uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
    uploadArea?.addEventListener('dragleave', () => { uploadArea.classList.remove('drag-over'); });
    uploadArea?.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('drag-over');
        if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });

    encryptBtn?.addEventListener('click', encryptImage);
    updateButtonState();
    console.log("✅ أداة حماية الصور جاهزة للاستخدام");
};
