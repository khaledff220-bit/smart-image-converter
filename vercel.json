{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tools/:path", "destination": "/en/tools/:path.html" },
    { "source": "/compress-pdf", "destination": "/compress-pdf.html" },
    { "source": "/decrypt", "destination": "/decrypt.html" },
    { "source": "/image-quality", "destination": "/image-quality.html" },
    { "source": "/merge-pdf", "destination": "/merge-pdf.html" },
    { "source": "/password-protect", "destination": "/password-protect.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
